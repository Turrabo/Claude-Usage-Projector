# Rust build artifacts
/target/

# xwin's default cache location when --output isn't passed. The cargo-xwin
# pipeline keeps its real cache at %LOCALAPPDATA%\cargo-xwin\, but a bare
# `xwin splat` from this directory would drop one here.
/.xwin-cache/

# .NET predictor build artifacts (fork-specific). Glob form so the sub-project
# under predictor/Predictor.Tests/ is also covered.
/predictor/**/bin/
/predictor/**/obj/

# Cargo lock (optional for binaries, included by default)
# Cargo.lock

# Debug/log files
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Local release workflow helper
workflow.cmd

# Local WinGet manifest generation output
/manifests/
